# MDX FSAI — RViz Configuration
# Fixed frame: Fr1A (X-forward, Y-left, Z-up)
# Add your team's displays below the existing sections.

Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /── PERCEPTION ──1
        - /── CAR ──1
      Splitter Ratio: 0.5
    Tree Height: 900
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:

    # ── BASE ─────────────────────────────────────────────────────────────────

    - Alpha: 1
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 80; 80; 80
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true

    # ── PERCEPTION ───────────────────────────────────────────────────────────

    # Raw LiDAR point cloud
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Class: rviz_default_plugins/PointCloud2
      Color: 200; 200; 200
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Name: LiDAR Scan
      Size (Pixels): 2
      Size (m): 0.04
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /perception/pointcloud
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # Fused cones — 3D mesh markers with colour labels
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Cone Markers
      Namespaces:
        cones: true
        cone_labels: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cone_markers
      Value: true

    # YOLO-annotated camera feed
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: YOLO Camera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /perception/camera/image
      Value: true

    # ── CAR ──────────────────────────────────────────────────────────────────

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Car Body
      Namespaces:
        car_body: true
        car_wheels: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /car_marker
      Value: true

    # ── PERCEPTION DEBUG ─────────────────────────────────────────────────────

    # Raw LiDAR detections (pre-fusion) — all grey/ghost. Lets you debug the
    # clustering independently of the camera/fusion. From the debug cone_visualizer
    # (/perception/lidar/cones -> /lidar_cone_markers).
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Raw LiDAR Cones
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lidar_cone_markers
      Value: true

    # ── NAVIGATION ───────────────────────────────────────────────────────────

    # Active path the follower is tracking (skidpad / autocross / trackdrive)
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.05
      Name: Active Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Volatile
        Value: /nav/active_path
      Value: true

    # Pure-pursuit follower debug markers (lookahead point, target, etc.)
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Path Follower Debug
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /nav/local_path_follower_markers
      Value: true

    # Perceived midline path markers (autocross / trackdrive planner)
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Perceived Path
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /nav/perceived_path_markers
      Value: true

    # Forward-distance controller (acceleration mission) — off by default
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Fwd-Distance Debug
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /nav/forward_distance_controller_markers
      Value: true

    # Skidpad geometric path markers — off by default
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Skidpad Path
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /nav/skidpad_path_markers
      Value: true

    # ── LOCALIZATION ─────────────────────────────────────────────────────────

    # Vehicle odometry (wheel + IMU dead-reckoning) — pose arrow trail
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 1
          Value: true
        Value: false
      Enabled: true
      Keep: 100
      Name: Vehicle Odometry
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 1
        Axes Radius: 0.1
        Color: 255; 25; 0
        Head Length: 0.3
        Head Radius: 0.1
        Shaft Length: 0.5
        Shaft Radius: 0.05
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/vehicle
      Value: true

    # ── ADD YOUR DISPLAYS HERE ───────────────────────────────────────────────

  Enabled: true
  Global Options:
    Background Color: 20; 20; 25
    Fixed Frame: Fr1A
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Focal Point:
        X: 8
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.65
      Target Frame: Fr1A
      Value: Orbit (rviz)
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: false
  Width: 1600
  X: 0
  Y: 0